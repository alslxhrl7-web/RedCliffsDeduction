#usda 1.0
(
    defaultPrim = "root"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "root"
{
    def Material "mat_3"
    {
        token outputs:surface.connect = </root/mat_3/surface.outputs:surface>
        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:ior = 1.5
            color3f inputs:diffuseColor.connect = </root/mat_3/base_color.outputs:rgb>
            normal3f inputs:normal.connect = </root/mat_3/normal.outputs:rgb>
            float inputs:occlusion.connect = </root/mat_3/orm.outputs:r>
            float inputs:roughness.connect = </root/mat_3/orm.outputs:g>
            float inputs:metallic.connect = </root/mat_3/orm.outputs:b>
            token outputs:surface
        }
        def Shader "base_color"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @mat_3_base_color.png@
            float3 outputs:rgb
        }
        def Shader "normal"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @mat_3_normal.png@
            float3 outputs:rgb
        }
        def Shader "orm"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @mat_3_orm.png@
            float outputs:r
            float outputs:g
            float outputs:b
        }
    }
